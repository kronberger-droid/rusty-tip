{
  "tool": "tip_prep",
  "kinds": [
    {
      "kind": "tip_prep/cycle",
      "schema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "description": "One pulse cycle: what was fired, what was measured afterwards.\n\nThe GUI's status panel and pulse history are drawn from this.",
        "properties": {
          "cycle": {
            "description": "1-based cycle number.",
            "format": "uint",
            "minimum": 0,
            "type": "integer"
          },
          "elapsed_secs": {
            "description": "Seconds since the budget clock started.",
            "format": "double",
            "type": "number"
          },
          "freq_shift": {
            "description": "Frequency shift measured after the reposition, in Hz.",
            "format": "double",
            "type": "number"
          },
          "is_sharp": {
            "description": "Whether `freq_shift` fell inside the sharp window.",
            "type": "boolean"
          },
          "pulse_voltage": {
            "description": "The pulse as fired, sign included, in volts.",
            "format": "double",
            "type": "number"
          }
        },
        "required": [
          "cycle",
          "elapsed_secs",
          "freq_shift",
          "pulse_voltage",
          "is_sharp"
        ],
        "title": "CycleEvent",
        "type": "object"
      }
    },
    {
      "kind": "tip_prep/phase",
      "schema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "description": "A change of phase: pulsing, or a step of the sharpness confirmation and\nstability check.",
        "oneOf": [
          {
            "description": "The pulse cycles are running: at the start, and again after a\nconfirmation or stability check that did not end the run.",
            "properties": {
              "phase": {
                "const": "pulsing",
                "type": "string"
              }
            },
            "required": [
              "phase"
            ],
            "type": "object"
          },
          {
            "description": "Three reposition-and-read confirmations are starting.",
            "properties": {
              "phase": {
                "const": "confirming",
                "type": "string"
              }
            },
            "required": [
              "phase"
            ],
            "type": "object"
          },
          {
            "description": "Confirmed sharp; the bias sweeps are starting.",
            "properties": {
              "baseline_freq_shift": {
                "description": "The confirmed frequency shift the final read is compared to, Hz.",
                "format": "double",
                "type": "number"
              },
              "phase": {
                "const": "stability_check",
                "type": "string"
              }
            },
            "required": [
              "phase",
              "baseline_freq_shift"
            ],
            "type": "object"
          },
          {
            "description": "The final read stayed within the allowed change: the tip is done.",
            "properties": {
              "final_freq_shift": {
                "format": "double",
                "type": "number"
              },
              "phase": {
                "const": "stable",
                "type": "string"
              }
            },
            "required": [
              "phase",
              "final_freq_shift"
            ],
            "type": "object"
          },
          {
            "description": "The final read moved past the allowed change.",
            "properties": {
              "change": {
                "description": "`|final - baseline|`, Hz.",
                "format": "double",
                "type": "number"
              },
              "final_freq_shift": {
                "format": "double",
                "type": "number"
              },
              "phase": {
                "const": "unstable",
                "type": "string"
              },
              "threshold": {
                "description": "The configured allowed change, Hz.",
                "format": "double",
                "type": "number"
              }
            },
            "required": [
              "phase",
              "final_freq_shift",
              "change",
              "threshold"
            ],
            "type": "object"
          }
        ],
        "title": "PhaseEvent"
      }
    },
    {
      "kind": "tip_prep/max_pulse",
      "schema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "description": "The maximum-voltage pulse fired after a failed stability check, with the\ntip still engaged from the final read.",
        "properties": {
          "pulse_voltage": {
            "description": "The pulse as fired, sign included, in volts.",
            "format": "double",
            "type": "number"
          }
        },
        "required": [
          "pulse_voltage"
        ],
        "title": "MaxPulseEvent",
        "type": "object"
      }
    },
    {
      "kind": "tip_prep/config_reloaded",
      "schema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "description": "The run switched to a config handed to it while running, between two\npulse cycles.",
        "properties": {
          "after_cycle": {
            "description": "The last cycle run on the config before, 0 before the first.",
            "format": "uint",
            "minimum": 0,
            "type": "integer"
          },
          "config": {
            "description": "The config as applied, the run's own setup kept."
          },
          "kept": {
            "description": "Paths of the fields the sent config changed but the run kept, as\nthey describe its setup. They apply from the next run.",
            "items": {
              "type": "string"
            },
            "type": "array"
          }
        },
        "required": [
          "after_cycle",
          "config",
          "kept"
        ],
        "title": "ConfigReloadedEvent",
        "type": "object"
      }
    },
    {
      "kind": "controller/applied",
      "schema": {
        "$defs": {
          "ControllerId": {
            "description": "One controller on the machine.",
            "oneOf": [
              {
                "description": "The Z feedback loop. Nanonis defines several and runs one; which\none is the `active` parameter.",
                "properties": {
                  "kind": {
                    "const": "z",
                    "type": "string"
                  }
                },
                "required": [
                  "kind"
                ],
                "type": "object"
              },
              {
                "description": "The PLL's oscillation amplitude loop, per modulator (1 or 2).",
                "properties": {
                  "kind": {
                    "const": "pll_amplitude",
                    "type": "string"
                  },
                  "modulator": {
                    "format": "uint8",
                    "maximum": 255,
                    "minimum": 0,
                    "type": "integer"
                  }
                },
                "required": [
                  "kind",
                  "modulator"
                ],
                "type": "object"
              },
              {
                "description": "The PLL's phase loop, which tracks the resonance, per modulator.",
                "properties": {
                  "kind": {
                    "const": "pll_phase",
                    "type": "string"
                  },
                  "modulator": {
                    "format": "uint8",
                    "maximum": 255,
                    "minimum": 0,
                    "type": "integer"
                  }
                },
                "required": [
                  "kind",
                  "modulator"
                ],
                "type": "object"
              }
            ]
          },
          "ControllerParams": {
            "description": "The parameters of one controller, whichever kind it is.",
            "oneOf": [
              {
                "$ref": "#/$defs/ZControllerParams",
                "properties": {
                  "kind": {
                    "const": "z",
                    "type": "string"
                  }
                },
                "required": [
                  "kind"
                ],
                "type": "object"
              },
              {
                "$ref": "#/$defs/PllAmplitudeParams",
                "properties": {
                  "kind": {
                    "const": "pll_amplitude",
                    "type": "string"
                  }
                },
                "required": [
                  "kind"
                ],
                "type": "object"
              },
              {
                "$ref": "#/$defs/PllPhaseParams",
                "properties": {
                  "kind": {
                    "const": "pll_phase",
                    "type": "string"
                  }
                },
                "required": [
                  "kind"
                ],
                "type": "object"
              }
            ]
          },
          "PllAmplitudeParams": {
            "description": "The PLL amplitude loop: keeps the oscillation amplitude at a setpoint\nby driving the excitation.",
            "properties": {
              "bandwidth_hz": {
                "default": 100.0,
                "description": "Demodulator bandwidth of the amplitude signal.",
                "format": "double",
                "type": "number",
                "x-unit": "Hz"
              },
              "p_gain_v_m": {
                "default": 100000.0,
                "description": "Proportional gain, excitation volts per metre of amplitude error.",
                "format": "double",
                "type": "number",
                "x-unit": "V/m"
              },
              "setpoint_m": {
                "default": 1e-10,
                "description": "Oscillation amplitude to hold.",
                "format": "double",
                "type": "number",
                "x-display-unit": "pm",
                "x-unit": "m"
              },
              "time_constant_s": {
                "default": 0.001,
                "description": "Time constant; the integral gain is P over this.",
                "format": "double",
                "type": "number",
                "x-display-unit": "ms",
                "x-unit": "s"
              }
            },
            "type": "object"
          },
          "PllPhaseParams": {
            "description": "The PLL phase loop: keeps the phase at its reference by shifting the\nexcitation frequency, which is what makes the frequency shift a signal.",
            "properties": {
              "bandwidth_hz": {
                "default": 100.0,
                "description": "Demodulator bandwidth of the phase signal.",
                "format": "double",
                "type": "number",
                "x-unit": "Hz"
              },
              "p_gain_hz_deg": {
                "default": 1.0,
                "description": "Proportional gain, hertz of frequency shift per degree of phase error.",
                "format": "double",
                "type": "number",
                "x-unit": "Hz/°"
              },
              "time_constant_s": {
                "default": 0.001,
                "description": "Time constant; the integral gain is P over this.",
                "format": "double",
                "type": "number",
                "x-display-unit": "ms",
                "x-unit": "s"
              }
            },
            "type": "object"
          },
          "ZControllerParams": {
            "description": "The Z-controller's settable parameters. The setpoint is in the unit of\nthe active controller's input signal, amperes for a current loop and\nhertz for a frequency-shift loop, which is why it carries no unit here;\n[`input`](Self::input) says which from the active controller's name.",
            "properties": {
              "active": {
                "default": "",
                "description": "Which of the defined controllers runs, by name from the list the\nreading carries. Empty leaves the active one as it is.",
                "type": "string"
              },
              "limits_enabled": {
                "default": false,
                "description": "Whether the Z position limits below apply.",
                "type": "boolean"
              },
              "limits_m": {
                "default": [
                  0.0,
                  0.0
                ],
                "description": "Z position limits, low then high, as a range is written. Nanonis\nsends and takes them high first; the controller turns them round. A\nfile may give them either way, since the low limit is the smaller:\npresets saved high first still load as they were meant. Without\n`limits_enabled` these read as the piezo range and a write is\nignored.",
                "maxItems": 2,
                "minItems": 2,
                "prefixItems": [
                  {
                    "format": "double",
                    "type": "number"
                  },
                  {
                    "format": "double",
                    "type": "number"
                  }
                ],
                "type": "array",
                "x-display-unit": "nm",
                "x-enabled-by": "limits_enabled",
                "x-unit": "m"
              },
              "p_gain_m": {
                "default": 2e-10,
                "description": "Proportional gain: how far Z moves per unit of error.",
                "format": "double",
                "type": "number",
                "x-display-unit": "pm",
                "x-unit": "m"
              },
              "setpoint": {
                "default": 5e-11,
                "description": "Setpoint, in the input signal's own unit.",
                "format": "double",
                "type": "number"
              },
              "switch_off_delay_s": {
                "default": 0.0,
                "description": "Z is averaged over this before the loop switches off, so the\nparked position is reproducible.",
                "format": "double",
                "type": "number",
                "x-display-unit": "ms",
                "x-unit": "s"
              },
              "time_constant_s": {
                "default": 0.001,
                "description": "Time constant; the integral gain is P over this.",
                "format": "double",
                "type": "number",
                "x-display-unit": "ms",
                "x-unit": "s"
              },
              "tip_lift_m": {
                "default": 0.0,
                "description": "Retract by this much when the loop is switched off.",
                "format": "double",
                "type": "number",
                "x-display-unit": "nm",
                "x-unit": "m"
              },
              "withdraw_rate_m_s": {
                "default": null,
                "description": "Slew rate of a withdraw. Unset is unlimited, which the module\nshows as `Inf`; a JSON number cannot be infinite, so it is an\noption here.",
                "format": "double",
                "type": [
                  "number",
                  "null"
                ],
                "x-display-unit": "nm/s",
                "x-unit": "m/s"
              }
            },
            "type": "object"
          }
        },
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "description": "One controller written: what it held before and what it holds now,\nread back after the write, so a clamped or refused value shows.",
        "properties": {
          "after": {
            "$ref": "#/$defs/ControllerParams"
          },
          "before": {
            "$ref": "#/$defs/ControllerParams"
          },
          "id": {
            "$ref": "#/$defs/ControllerId"
          }
        },
        "required": [
          "id",
          "before",
          "after"
        ],
        "title": "ControllerAppliedEvent",
        "type": "object"
      }
    },
